node_modules/
backend/node_modules/
frontend/node_modules/
devsecureFrontend/node_modules/

# Environment files
.env
.env.local
.env.production
backend/.env
frontend/.env

# Logs
*.log
npm-debug.log*

# OS files
.DS_Store
Thumbs.db

# IDE files
.vscode/
.idea/

